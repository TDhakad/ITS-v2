OPENAI_API_KEY=
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional. Use this when an existing Pinecone index has a smaller dimension, e.g. 1024.
OPENAI_EMBEDDING_DIMENSIONS=
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PINECONE_API_KEY=
PINECONE_KB_INDEX_NAME=its-knowledge-base
PINECONE_TICKET_INDEX_NAME=its-tickets
DATABASE_URL=sqlite:///./data/helpdesk.db
KB_DIR=./kb
MAX_REQUIREMENT_TURNS=3
STANDARD_USER_CLEARANCE=public

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=capstone-its-v2
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
